name: Test deployment

on:
  pull_request:
    branches:
      - main
    paths:
      - 'website/**'
      
jobs:
  test-deploy:
    name: Test deployment
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0

      # website/yarn.lock is written by the first `make website`; commit it
      # before enabling this workflow (the install below is --frozen-lockfile).
      - uses: actions/setup-node@v7
        with:
          node-version: 22
          cache: yarn
          cache-dependency-path: website/yarn.lock

      - name: Install dependencies
        run: yarn install --frozen-lockfile
        working-directory: website

      - name: Test build website
        run: yarn build
        working-directory: website